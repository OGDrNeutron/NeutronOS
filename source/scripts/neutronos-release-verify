#!/usr/bin/python3
"""Verify release bytes against the independently installed OpenPGP trust root."""
from pathlib import Path
import json,os,stat,subprocess,sys,tempfile
TRUSTED_KEY=Path('/etc/neutronos/keys/neutronos-release.gpg')
EXPECTED_FINGERPRINT='F1A1E10BD2DB35060D6E61187CEB773D5ABD64B0'
class Denied(RuntimeError):pass
def verify(metadata:bytes,signature:bytes,key_path=TRUSTED_KEY,require_owner=True):
 if not metadata or len(metadata)>1024*1024 or not signature or len(signature)>16384:raise Denied('Missing or oversized signed release metadata/signature.')
 try:info=key_path.lstat()
 except OSError:raise Denied('The pinned NeutronOS release public key is unavailable.') from None
 if not stat.S_ISREG(info.st_mode) or info.st_mode&0o022 or (require_owner and info.st_uid!=0):raise Denied('The installed release trust key has unsafe ownership or permissions.')
 with tempfile.TemporaryDirectory(prefix='neutronos-release-verify-') as folder:
  root=Path(folder);os.chmod(root,0o700);meta=root/'manifest';sig=root/'signature';meta.write_bytes(metadata);sig.write_bytes(signature)
  result=subprocess.run(['/usr/bin/gpg','--batch','--no-options','--homedir',str(root),'--no-default-keyring','--keyring',str(key_path),'--no-auto-check-trustdb','--lock-never','--no-auto-key-retrieve','--auto-key-locate','clear','--trust-model','always','--status-fd','1','--verify',str(sig),str(meta)],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30,env={'PATH':'/usr/bin:/bin','LANG':'C'})
 records=[line.split() for line in result.stdout.decode('utf-8','replace').splitlines() if line.startswith('[GNUPG:] ')]
 valid=[r for r in records if len(r)>=3 and r[1]=='VALIDSIG']
 rejected={'BADSIG','ERRSIG','NO_PUBKEY','EXPSIG','EXPKEYSIG','REVKEYSIG','FAILURE','NODATA'}
 if result.returncode or not valid or any(r[1] in rejected for r in records) or any(r[2]!=EXPECTED_FINGERPRINT and r[-1]!=EXPECTED_FINGERPRINT for r in valid):raise Denied('NeutronOS release signature is invalid, unsigned, expired, revoked or from an untrusted signer.')
 return {'success':True,'fingerprint':EXPECTED_FINGERPRINT,'algorithm':'OpenPGP','trustSource':str(TRUSTED_KEY)}
def main():
 try:
  if len(sys.argv)!=4 or sys.argv[1]!='verify':raise Denied('Usage: neutronos-release-verify verify MANIFEST SIGNATURE')
  metadata=Path(sys.argv[2]).read_bytes();signature=Path(sys.argv[3]).read_bytes()
  print(json.dumps(verify(metadata,signature),sort_keys=True));return 0
 except (Denied,OSError,subprocess.SubprocessError) as error:
  print('NeutronOS release verification failed: '+str(error),file=sys.stderr);return 78
if __name__=='__main__':raise SystemExit(main())
