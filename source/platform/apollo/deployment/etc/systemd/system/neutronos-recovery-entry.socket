[Unit]
Description=Entry-only transport to existing NeutronOS one-shot Recovery
DefaultDependencies=no
After=systemd-remount-fs.service
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenStream=/run/neutronos-recovery-entry.sock
SocketUser=root
SocketGroup=neutronos-shell
SocketMode=0660
RemoveOnStop=yes
Service=neutronos-recovery-entry.service

[Install]
WantedBy=multi-user.target
