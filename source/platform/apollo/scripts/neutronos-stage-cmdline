#!/usr/bin/env python3
"""Stage the minimal NeutronOS graphical-boot cmdline token change.

This helper never edits the input path. The caller must validate the staged
output and perform any live replacement separately.
"""

from __future__ import annotations

import argparse
import pathlib
import sys


REMOVED = {
    "console=tty1",
    # Normalize the Plymouth tokens below to one canonical copy.
    "plymouth.ignore-serial-consoles",
    "ignore_loglevel",
    "quiet",
    "splash",
    "resize",
    "vt.global_cursor_default=0",
}


def mutable(token: str) -> bool:
    return (
        token in REMOVED
        or token.startswith("systemd.show_status=")
        or token.startswith("loglevel=")
        or token.startswith("vt.global_cursor_default=")
    )


def stage(tokens: list[str]) -> list[str]:
    roots = [token for token in tokens if token.startswith("root=")]
    if len(roots) != 1 or not roots[0].startswith("root=PARTUUID="):
        raise ValueError("exactly one root=PARTUUID token is required")

    required = {
        "console=serial0,115200",
        "rootfstype=ext4",
        "fsck.repair=yes",
        "rootwait",
    }
    missing = sorted(required.difference(tokens))
    if missing:
        raise ValueError("required recovery/storage tokens missing: " + ", ".join(missing))
    result: list[str] = []
    for token in tokens:
        if token in REMOVED or token.startswith("vt.global_cursor_default="):
            continue
        if token.startswith("systemd.show_status=") or token.startswith("loglevel="):
            continue
        else:
            result.append(token)

    result.extend([
        "systemd.show_status=false",
        "loglevel=3",
        "quiet",
        "splash",
        "plymouth.ignore-serial-consoles",
        "vt.global_cursor_default=0",
    ])

    protected_before = [token for token in tokens if not mutable(token)]
    protected_after = [token for token in result if not mutable(token)]
    if protected_before != protected_after:
        raise ValueError("an unrelated cmdline token changed")
    if roots[0] not in result:
        raise ValueError("root PARTUUID changed")
    if "console=tty1" in result or "ignore_loglevel" in result:
        raise ValueError("visible console verbosity remains enabled")
    if "resize" in result:
        raise ValueError("first-boot root resize remains enabled")
    if result.count("splash") != 1:
        raise ValueError("Plymouth splash token is not singular")
    if result.count("plymouth.ignore-serial-consoles") != 1:
        raise ValueError("Plymouth serial-console guard is not singular")
    if result.count("systemd.show_status=false") != 1:
        raise ValueError("systemd status suppression is not singular")
    if result.count("loglevel=3") != 1:
        raise ValueError("kernel log level is not singular")
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("input", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    arguments = parser.parse_args()

    original_text = arguments.input.read_text(encoding="utf-8")
    if "\n" in original_text.strip("\n"):
        raise ValueError("cmdline input must contain exactly one logical line")
    original = original_text.split()
    staged = stage(original)
    arguments.output.write_text(" ".join(staged) + "\n", encoding="utf-8")

    print("preserved root:", next(token for token in staged if token.startswith("root=")))
    print("staged tokens:", len(staged))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"neutronos-stage-cmdline: {error}", file=sys.stderr)
        raise SystemExit(1)
