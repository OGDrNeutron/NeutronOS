#!/usr/bin/env python3
import argparse, json, sys
from pathlib import Path
from neutronos_firewall import FirewallActivator, generate

parser = argparse.ArgumentParser()
parser.add_argument("config")
parser.add_argument("--check", action="store_true")
args = parser.parse_args()
rules = generate(json.loads(Path(args.config).read_text(encoding="utf-8")))
if args.check:
    ok, error = FirewallActivator(Path("/tmp/neutronos-firewall-check")).validate(rules)
    if not ok: print(error, file=sys.stderr); raise SystemExit(2)
print(rules, end="")
