[Unit]
Description=NeutronOS Bluetooth enabled-by-default policy (hci0 only)
Documentation=man:rfkill(8)
Wants=bluetooth.service
After=bluetooth.service systemd-rfkill.service
Before=neutronos-controller-status-bridge.service
StartLimitIntervalSec=30
StartLimitBurst=10
ConditionPathExists=/sys/class/bluetooth/hci0

[Service]
Type=oneshot
# The helper waits for the release BlueZ D-Bus object and verifies Powered=true.
# It does not touch wlan0, Wi-Fi profiles, or existing Bluetooth bonds.
ExecStart=/usr/local/sbin/neutronos-privileged-helper prepare-controller-bluetooth
RemainAfterExit=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
