[Unit]
Description=NeutronOS Firewall Life-Support Guard
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target neutron-securityd.service neutronos.service neutron-remote-service.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/usr/local/lib/neutronos
ExecStart=/usr/bin/python3 /usr/local/lib/neutronos/neutronos-firewall-guard.py
Restart=always
RestartSec=1
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
ReadWritePaths=/var/lib/neutronos/security-core

[Install]
WantedBy=sysinit.target
