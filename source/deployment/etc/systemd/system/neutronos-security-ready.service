[Unit]
Description=Wait for authoritative NeutronOS Security state
After=neutron-securityd.service neutronos-state-setup.service
Wants=neutron-securityd.service
Before=neutronos.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/neutronos-security-ready.py
User=root
Group=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/neutronos/security-core /var/lib/neutronos/setup /run/neutronos/security

[Install]
WantedBy=multi-user.target
