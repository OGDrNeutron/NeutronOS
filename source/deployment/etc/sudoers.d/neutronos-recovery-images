# Full-image operations retain backend signature and offline-target checks.
Defaults!/usr/local/lib/neutronos/neutronos-update-recovery env_reset,secure_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
neutronos ALL=(root) NOPASSWD: /usr/local/lib/neutronos/neutronos-update-recovery image-catalog
neutronos ALL=(root) NOPASSWD: /usr/local/lib/neutronos/neutronos-update-recovery image-download *
neutronos ALL=(root) NOPASSWD: /usr/local/lib/neutronos/neutronos-update-recovery image-cancel
neutronos ALL=(root) NOPASSWD: /usr/local/lib/neutronos/neutronos-update-recovery image-targets *
neutronos ALL=(root) NOPASSWD: /usr/local/lib/neutronos/neutronos-update-recovery image-install *
