# Reference only. Active service unit is created by deploy-gemini-reviewed.sh.
# System Python standard library: no venv, pip or dependency installation.
[Unit]
Description=NeutronOS Manager (native Python read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neutron-manager
Group=neutron-manager
WorkingDirectory=/opt/neutronos-manager
EnvironmentFile=/etc/neutronos-manager/environment
ExecStart=/usr/bin/python3 -I /opt/neutronos-manager/server/native_manager.py
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/neutron-manager

[Install]
WantedBy=multi-user.target
